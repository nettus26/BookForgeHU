<Window x:Class="BookForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BookForge.App"
        Title="BookForge"
        Height="700"
        Width="1300"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:BookProgressTextConverter x:Key="BookProgressTextConverter"/>
        <local:BookProgressPercentConverter x:Key="BookProgressPercentConverter"/>
    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- FEJLÉC -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="0">

            <TextBlock
                Text="📚 BookForge"
                FontSize="32"
                FontWeight="Bold"/>

            <Button
                Content="📂 EPUB hozzáadása"
                Width="180"
                Height="40"
                HorizontalAlignment="Left"
                Margin="0,15,0,15"
                Click="AddEpub_Click"/>

        </StackPanel>

        <!-- ===================================================== -->
        <!-- FŐTERÜLET -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- KÖNYVTÁR -->
            <!-- ================================================= -->

            <GroupBox
                Header="Könyvtár"
                Grid.Column="0"
                Margin="0,0,10,0">

                <DockPanel>

                    <!-- KERESÉS ÉS RENDEZÉS -->

                    <StackPanel
                        DockPanel.Dock="Top">

                        <Grid
                            Margin="5,5,5,3">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="LibrarySearchBox"
                                Grid.Column="0"
                                Height="32"
                                Padding="8,0"
                                VerticalContentAlignment="Center"
                                TextChanged="LibrarySearchBox_TextChanged"
                                ToolTip="Keresés cím vagy szerző alapján..."/>

                            <Button
                                x:Name="ClearLibrarySearchButton"
                                Grid.Column="1"
                                Content="✕"
                                Width="32"
                                Height="32"
                                Margin="5,0,0,0"
                                ToolTip="Keresés törlése"
                                Click="ClearLibrarySearchButton_Click"/>

                        </Grid>

                        <ComboBox
                            x:Name="LibrarySortComboBox"
                            Height="32"
                            Margin="5,3,5,3"
                            SelectionChanged="LibrarySortComboBox_SelectionChanged"
                            ToolTip="Könyvek rendezése">

                            <ComboBoxItem
                                Content="Alapértelmezett"
                                IsSelected="True"/>

                            <ComboBoxItem
                                Content="Cím szerint"/>

                            <ComboBoxItem
                                Content="Szerző szerint"/>

                            <ComboBoxItem
                                Content="Legutóbb olvasott"/>

                            <ComboBoxItem
                                Content="Olvasatlan"/>

                            <ComboBoxItem
                                Content="Folyamatban"/>

                            <ComboBoxItem
                                Content="Befejezett"/>

                        </ComboBox>

                        <TextBlock
                            x:Name="LibraryResultCountText"
                            Text="0 könyv"
                            FontSize="11"
                            Margin="7,0,5,5"/>

                    </StackPanel>

                    <Button
                        DockPanel.Dock="Bottom"
                        Content="🗑 Könyv törlése"
                        Height="35"
                        Margin="5"
                        Click="DeleteBook_Click"/>

                    <TextBlock
                        x:Name="LibraryNoResultsText"
                        Text="📭 Nincs találat."
                        FontSize="13"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextAlignment="Center"
                        Margin="10"
                        Visibility="Collapsed"/>

                    <ListBox
                        x:Name="BookList"
                        SelectionChanged="BookList_SelectionChanged"
                        BorderThickness="0"
                        Background="Transparent"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Margin="4,5,4,5"
                                    Padding="8"
                                    BorderThickness="1"
                                    CornerRadius="6">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="54"
                                            Height="78"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Center">

                                            <TextBlock
                                                Text="📖"
                                                FontSize="26"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </Border>

                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="10,0,2,0"
                                            VerticalAlignment="Center">

                                            <TextBlock
                                                Text="{Binding Title}"
                                                FontWeight="Bold"
                                                FontSize="14"
                                                TextWrapping="Wrap"/>

                                            <TextBlock
                                                Text="{Binding Author}"
                                                FontSize="12"
                                                Margin="0,3,0,6"
                                                TextWrapping="Wrap"/>

                                            <TextBlock
                                                Text="{Binding Path=., Mode=OneWay, Converter={StaticResource BookProgressTextConverter}}"
                                                FontSize="11"/>

                                            <ProgressBar
                                                Height="7"
                                                Margin="0,5,0,0"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="{Binding Path=., Mode=OneWay, Converter={StaticResource BookProgressPercentConverter}}"/>

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </DockPanel>

            </GroupBox>

            <!-- ================================================= -->
            <!-- KÖNYV ADATOK -->
            <!-- ================================================= -->

            <GroupBox
                Header="Könyv adatok"
                Grid.Column="1"
                Margin="0,0,10,0">

                <ScrollViewer>

                    <StackPanel
                        Margin="10"
                        HorizontalAlignment="Center">

                        <Image
                            x:Name="CoverImageBox"
                            Width="200"
                            Height="300"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,20"/>

                        <TextBlock
                            Text="Cím:"
                            FontWeight="Bold"/>

                        <TextBlock
                            x:Name="BookTitleText"/>

                        <TextBlock
                            Text="Szerző:"
                            FontWeight="Bold"
                            Margin="0,10,0,0"/>

                        <TextBlock
                            x:Name="BookAuthorText"/>

                        <TextBlock
                            Text="Nyelv:"
                            FontWeight="Bold"
                            Margin="0,10,0,0"/>

                        <TextBlock
                            x:Name="BookLanguageText"/>

                        <TextBlock
                            Text="Hozzáadva:"
                            FontWeight="Bold"
                            Margin="0,10,0,0"/>

                        <TextBlock
                            x:Name="BookDateText"/>

                        <TextBlock
                            Text="Fejezetek:"
                            FontWeight="Bold"
                            Margin="0,10,0,0"/>

                        <TextBlock
                            x:Name="BookChapterCountText"
                            Text="0"/>

                        <TextBlock
                            Text="Elolvasva:"
                            FontWeight="Bold"
                            Margin="0,10,0,0"/>

                        <TextBlock
                            x:Name="BookReadCountText"
                            Text="0 / 0"/>

                        <TextBlock
                            Text="Olvasási haladás:"
                            FontWeight="Bold"
                            Margin="0,10,0,0"/>

                        <TextBlock
                            x:Name="BookProgressText"
                            Text="0%"/>

                        <ProgressBar
                            x:Name="BookProgressBar"
                            Minimum="0"
                            Maximum="100"
                            Value="0"
                            Height="10"
                            Width="220"
                            Margin="0,8,0,8"
                            HorizontalAlignment="Center"/>

                        <Button
                            x:Name="ContinueReadingButton"
                            Content="▶ Folytatás"
                            Width="150"
                            Height="38"
                            Margin="0,20,0,10"
                            HorizontalAlignment="Center"
                            Click="ContinueReadingButton_Click"/>

                    </StackPanel>

                </ScrollViewer>

            </GroupBox>

            <!-- ================================================= -->
            <!-- NAVIGÁCIÓ -->
            <!-- ================================================= -->

            <GroupBox
                Header="Navigáció"
                Grid.Column="2"
                Margin="0,0,10,0">

                <TabControl>

                    <TabItem Header="📑 Tartalomjegyzék">

                        <ListView
                            x:Name="TocList"
                            SelectionChanged="TocList_SelectionChanged">

                            <ListView.ItemTemplate>

                                <DataTemplate>

                                    <TextBlock
                                        Text="{Binding Value}"
                                        FontWeight="Bold"
                                        Margin="5"/>

                                </DataTemplate>

                            </ListView.ItemTemplate>

                        </ListView>

                    </TabItem>

                    <TabItem Header="📖 Fejezetek">

                        <ListView
                            x:Name="ChapterList"
                            SelectionChanged="ChapterList_SelectionChanged">

                            <ListView.ItemTemplate>

                                <DataTemplate>

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Margin="5">

                                        <TextBlock
                                            Text="✓"
                                            FontWeight="Bold"
                                            Foreground="Green"
                                            Margin="0,0,6,0">

                                            <TextBlock.Style>

                                                <Style
                                                    TargetType="TextBlock">

                                                    <Setter
                                                        Property="Visibility"
                                                        Value="Collapsed"/>

                                                    <Style.Triggers>

                                                        <DataTrigger
                                                            Binding="{Binding IsRead}"
                                                            Value="True">

                                                            <Setter
                                                                Property="Visibility"
                                                                Value="Visible"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                        <TextBlock
                                            Text="{Binding Title}"
                                            FontWeight="Bold"/>

                                    </StackPanel>

                                </DataTemplate>

                            </ListView.ItemTemplate>

                        </ListView>

                    </TabItem>

                </TabControl>

            </GroupBox>

            <!-- ================================================= -->
            <!-- OLVASÓ -->
            <!-- ================================================= -->

            <GroupBox
                Header="Olvasó"
                Grid.Column="3">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ========================================= -->
                    <!-- OLVASÓ VEZÉRLŐSÁV -->
                    <!-- ========================================= -->

                    <Border
                        Grid.Row="0"
                        Margin="5"
                        Padding="8"
                        BorderThickness="1"
                        CornerRadius="6">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ELSŐ SOR: BETŰMÉRET + BETŰTÍPUS -->

                            <StackPanel
                                Grid.Row="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left">

                                <Button
                                    x:Name="DecreaseFontButton"
                                    Content="A−"
                                    Width="45"
                                    Height="32"
                                    Margin="0,0,5,0"
                                    ToolTip="Betűméret csökkentése"
                                    Click="DecreaseFontButton_Click"/>

                                <TextBlock
                                    x:Name="FontSizeText"
                                    Text="20 px"
                                    Width="55"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    TextAlignment="Center"
                                    FontWeight="Bold"
                                    Margin="0,0,5,0"/>

                                <Button
                                    x:Name="IncreaseFontButton"
                                    Content="A+"
                                    Width="45"
                                    Height="32"
                                    Margin="0,0,15,0"
                                    ToolTip="Betűméret növelése"
                                    Click="IncreaseFontButton_Click"/>

                                <TextBlock
                                    Text="Betűtípus:"
                                    VerticalAlignment="Center"
                                    Margin="0,0,5,0"/>

                                <ComboBox
                                    x:Name="FontFamilyComboBox"
                                    Width="120"
                                    Height="32"
                                    SelectionChanged="FontFamilyComboBox_SelectionChanged">

                                    <ComboBoxItem
                                        Content="Georgia"
                                        IsSelected="True"/>

                                    <ComboBoxItem
                                        Content="Arial"/>

                                    <ComboBoxItem
                                        Content="Verdana"/>

                                    <ComboBoxItem
                                        Content="Times New Roman"/>

                                    <ComboBoxItem
                                        Content="Courier New"/>

                                </ComboBox>

                            </StackPanel>

                            <!-- MÁSODIK SOR: SORKÖZ + TÉMA -->

                            <StackPanel
                                Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0">

                                <TextBlock
                                    Text="Sorköz:"
                                    VerticalAlignment="Center"
                                    Margin="0,0,5,0"/>

                                <ComboBox
                                    x:Name="LineSpacingComboBox"
                                    Width="90"
                                    Height="32"
                                    Margin="0,0,15,0"
                                    SelectionChanged="LineSpacingComboBox_SelectionChanged">

                                    <ComboBoxItem
                                        Content="1.3"/>

                                    <ComboBoxItem
                                        Content="1.5"
                                        IsSelected="True"/>

                                    <ComboBoxItem
                                        Content="1.7"/>

                                    <ComboBoxItem
                                        Content="2.0"/>

                                </ComboBox>

                                <Button
                                    x:Name="ThemeButton"
                                    Content="🌙 Sötét"
                                    Width="90"
                                    Height="32"
                                    ToolTip="Világos / sötét mód"
                                    Click="ThemeButton_Click"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <!-- ========================================= -->
                    <!-- WEBVIEW2 OLVASÓ -->
                    <!-- ========================================= -->

                    <Grid
                        x:Name="ReaderHost"
                        Grid.Row="1"
                        Margin="5"/>

                </Grid>

            </GroupBox>

        </Grid>

    </Grid>

</Window>
