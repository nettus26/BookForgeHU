<Window x:Class="BookForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BookForge"
        Height="700"
        Width="1300"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0">

            <TextBlock
                Text="📚 BookForge"
                FontSize="32"
                FontWeight="Bold"/>


            <Button
                Content="📂 EPUB hozzáadása"
                Width="180"
                Height="40"
                HorizontalAlignment="Left"
                Margin="0,15,0,15"
                Click="AddEpub_Click"/>

        </StackPanel>



        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>



            <!-- Könyvtár -->

            <GroupBox
                Header="Könyvtár"
                Grid.Column="0"
                Margin="0,0,10,0">

                <DockPanel>

                    <Button
                        DockPanel.Dock="Bottom"
                        Content="🗑 Könyv törlése"
                        Height="35"
                        Margin="5"
                        Click="DeleteBook_Click"/>


                    <ListView
                        x:Name="BookList"
                        SelectionChanged="BookList_SelectionChanged">

                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <StackPanel Margin="5">

                                    <TextBlock
                                        Text="{Binding Title}"
                                        FontWeight="Bold"/>

                                    <TextBlock
                                        Text="{Binding Author}"
                                        FontSize="12"/>

                                </StackPanel>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </DockPanel>

            </GroupBox>



            <!-- Könyv adatok + borító -->

            <GroupBox
                Header="Könyv adatok"
                Grid.Column="1"
                Margin="0,0,10,0">

                <ScrollViewer>

                    <StackPanel
                        Margin="10"
                        HorizontalAlignment="Center">


                        <Image
                            x:Name="CoverImageBox"
                            Width="200"
                            Height="300"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,20"/>



                        <TextBlock
                            Text="Cím:"
                            FontWeight="Bold"/>

                        <TextBlock
                            x:Name="BookTitleText"/>



                        <TextBlock
                            Text="Szerző:"
                            FontWeight="Bold"
                            Margin="0,10,0,0"/>

                        <TextBlock
                            x:Name="BookAuthorText"/>



                        <TextBlock
                            Text="Nyelv:"
                            FontWeight="Bold"
                            Margin="0,10,0,0"/>

                        <TextBlock
                            x:Name="BookLanguageText"/>



                        <TextBlock
                            Text="Hozzáadva:"
                            FontWeight="Bold"
                            Margin="0,10,0,0"/>

                        <TextBlock
                            x:Name="BookDateText"/>


                    </StackPanel>

                </ScrollViewer>

            </GroupBox>



            <!-- Fejezetek -->

            <GroupBox
                Header="Fejezetek"
                Grid.Column="2"
                Margin="0,0,10,0">

                <ListView
                    x:Name="ChapterList"
                    SelectionChanged="ChapterList_SelectionChanged">

                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <TextBlock
                                Text="{Binding Title}"
                                FontWeight="Bold"
                                Margin="5"/>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </GroupBox>



            <!-- Olvasó -->

            <GroupBox
                Header="Olvasó"
                Grid.Column="3">

                <ScrollViewer>

                    <StackPanel Margin="15">

                        <TextBlock
                            x:Name="ChapterTitleText"
                            FontSize="22"
                            FontWeight="Bold"
                            Margin="0,0,0,15"/>


                        <TextBlock
                            x:Name="ContentText"
                            Text="Válassz ki egy fejezetet"
                            TextWrapping="Wrap"
                            FontSize="16"/>
                        <Grid
    x:Name="ReaderHost"
    MinHeight="500"/>
                    </StackPanel>

                </ScrollViewer>

            </GroupBox>


        </Grid>

    </Grid>

</Window>